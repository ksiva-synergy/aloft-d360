{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "next/link": ["./src/compat/next-link.tsx"],
      "next/navigation": ["./src/compat/next-navigation.tsx"],
      "next/dynamic": ["./src/compat/next-dynamic.tsx"],
      "next/image": ["./src/compat/next-image.tsx"],
      "@/components/ui/*": ["../packages/aloft-shared/src/components/ui/*"],
      "@/lib/utils": ["../packages/aloft-shared/src/lib/utils"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../src/types/**/*.d.ts"]
}
