{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node scripts/guards/block-destructive-db.mjs",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node scripts/guards/block-destructive-db.mjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node scripts/guards/block-destructive-db.mjs",
        "matcher": "^(Read|Write|StrReplace|TabRead|TabWrite)$",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node scripts/guards/block-destructive-db.mjs",
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node scripts/guards/block-destructive-db.mjs",
        "failClosed": true
      }
    ]
  }
}
