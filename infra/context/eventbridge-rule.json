{
  "_comment": "Account 640012953890 / cluster aloft-agents-dev. Replace subnet-XXXXXXXX, subnet-YYYYYYYY, sg-ZZZZZZZZZ with C4/C5 before apply. Set TaskDefinitionArn revision (e.g. :1) to match ECS C10. RoleArn = aloftEventBridgeEcsRole. Do not enable rules until RunTask test passes.",

  "change_detect_daily": {
    "Name": "aloft-context-harvester-daily",
    "Description": "Trigger change_detect sweep daily at 04:00 UTC",
    "ScheduleExpression": "cron(0 4 * * ? *)",
    "State": "ENABLED",
    "Target": {
      "Id": "context-harvester-daily",
      "Arn": "arn:aws:ecs:ap-south-1:640012953890:cluster/aloft-agents-dev",
      "RoleArn": "arn:aws:iam::640012953890:role/aloftEventBridgeEcsRole",
      "EcsParameters": {
        "TaskDefinitionArn": "arn:aws:ecs:ap-south-1:640012953890:task-definition/aloft-context-harvester:1",
        "TaskCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "awsvpcConfiguration": {
            "Subnets": [
               "subnet-078e1b5479d75ad6e",
              "subnet-0179f6c831adafa9a"
            ],
            "SecurityGroups": ["sg-0f463f6c43d56bb11"],
            "AssignPublicIp": "ENABLED"
          }
        }
      },
      "Input": "{\"containerOverrides\":[{\"name\":\"context-harvester\",\"command\":[\"npx\",\"tsx\",\"--require\",\"./scripts/context/noserver.cjs\",\"scripts/context/orchestrator.ts\",\"--sweep\"]}]}"
    }
  },

