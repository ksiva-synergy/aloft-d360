{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HarvesterJobLogsInApp",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-south-1:640012953890:log-group:/ecs/aloft-context-harvester:*"
    },
    {
      "Sid": "HarvesterLogGroupLookup",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
