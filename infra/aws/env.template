# Copy values into .env / .env.local after Cloud recreates AWS resources.
# Do not commit real secrets.
# Full service map: docs/platform-services-and-recreation.md
# AWS rebuild steps: docs/aws-recreate-and-configuration.md

# ── Shared AWS (Next.js: Bedrock, ECS RunTask, Secrets Manager, S3) ─────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=640012953890
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Harvest T2/T3 LLM (semantic cards + usage narratives) ───────────────────
# xai (Grok — default when XAI_API_KEY is set), groq, or bedrock
HARVEST_LLM_PROVIDER=xai
HARVEST_XAI_MODEL=grok-4.7
# XAI_API_KEY / XAI_MODEL — same as Inspector (see below)
# HARVEST_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6  # when provider=bedrock

# ── Context harvest embed (T embed jobs) — same as Studio / semantic search ───
# Foundry is preferred when FOUNDRY_API_KEY + FOUNDRY_EMBEDDING_ENDPOINT (or FOUNDRY_ENDPOINT) are set.
# Fallback: AZURE_OPENAI_API_KEY + AZURE_OPENAI_EMBEDDING_ENDPOINT (or AZURE_OPENAI_ENDPOINT).
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=
FOUNDRY_EMBEDDING_ENDPOINT=
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Bedrock (Inspector / optional harvest fallback) ───────────────────────────
BEDROCK_REGION=us-east-1
# BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-5-5
# BEDROCK_OPUS_MODEL_ID=us.anthropic.claude-opus-5-5

# Bedrock Mantle — GPT-6 Luna (OpenAI-compatible; use us-east-1 for Luna)
# BEDROCK_MANTLE_REGION=us-east-1
# BEDROCK_MANTLE_API_KEY=
# Inspector default model key: sonnet-5-5 | opus-5-5 | gpt-6-luna
# INSPECTOR_DEFAULT_MODEL=sonnet-5-5

# ── RDS (if still using Aurora; skip if only connection string from Cloud) ───
# DATABASE_URL=postgresql://USER:PASSWORD@WRITER_HOST:5432/aloftdb?schema=public&sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@WRITER_HOST:5432/aloftdb?schema=public&sslmode=require

# ── ECS Fargate (context harvester + on-demand jobs from the app) ───────────
# Local/dev only: set HARVEST_RUNTIME=local so Estate Launch / reharvest spawn
# the orchestrator on this machine instead of ECS RunTask. Leave unset (or ecs)
# in staging/production.
# HARVEST_RUNTIME=local
ECS_CLUSTER_NAME=aloft-agents-dev
ECS_CONTEXT_TASK_DEFINITION=aloft-context-harvester
ECS_CONTEXT_CONTAINER_NAME=context-harvester
ECS_SUBNET_IDS=subnet-XXXXXXXX,subnet-YYYYYYYY
ECS_SECURITY_GROUP_IDS=sg-ZZZZZZZZ
ECS_ASSIGN_PUBLIC_IP=ENABLED
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::640012953890:role/aloftEcsTaskExecutionRole
ECS_TASK_ROLE_ARN=arn:aws:iam::640012953890:role/aloftEcsTaskRole

# Agent runner (separate image; provision-aloft-agents.sh)
# AGENT_RUNNER_SG_ID=sg-...
# AGENT_BASE_IMAGE=ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/aloft-agent-runner:latest

# ── S3 backfill ─────────────────────────────────────────────────────────────
BACKFILL_S3_BUCKET=pbc-vessel-data
BACKFILL_S3_REGION=ap-south-1
BACKFILL_S3_BROWSE_BUCKET=pbc-vessel-data
BACKFILL_S3_BROWSE_REGION=ap-south-1
