{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell|mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guards/block-destructive-db.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
